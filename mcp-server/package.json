{
  "name": "gym-system-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server (stdio) for the gym-system backend health checks",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
