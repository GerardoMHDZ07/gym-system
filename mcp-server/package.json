{
  "name": "gym-system-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server (stdio) for the gym-system backend: health check + login/session tools",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke:login": "npm run build && node scripts/smoke-login.mjs",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
